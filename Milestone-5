str.strip() != '')]\n\nN = 100\nstruct_8 = np.ones((3,3), dtype=int)\nwiped = {c: 0 for c in ['defect_a','defect_b','defect_c','defect_d']}\n\nfor _, row in positive.iterrows():\n    mask = rle_to_mask(row['mask_rle'], row['width'], row['height'])\n    labeled, nf = ndimage.label(mask, structure=struct_8)\n    if all(np.sum(labeled == i) < N for i in range(1, nf+1)):\n        wiped[row['defect_type']] += 1\n\ntotal = sum(wiped.values())\nworst = max(wiped, key=wiped.get)\n\nfor c in sorted(wiped):\n    print(f\"  {c}: {wiped[c]} wiped out\")\nprint(f\"\\nTotal wiped: {total}\")\nprint(f\"Worst class: {worst} ({wiped[worst]})\")\nprint(f\"\\n>>> ANSWER: {total}, {worst}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-18T10:43:58.190347Z","iopub.execute_input":"2026-11-18T10:43:58.191078Z","iopub.status.idle":"2026-11-18T10:44:06.093582Z","shell.execute_reply.started":"2026-11-18T10:43:58.191049Z","shell.execute_reply":"2026-11-18T10:44:06.092931Z"}},"outputs":[{"name":"stdout","text":"  defect_a: 22 wiped out\n  defect_b: 1 wiped out\n  defect_c: 24 wiped out\n  defect_d: 1 wiped out\n\nTotal wiped: 48\nWorst class: defect_c (24)\n\n>>> ANSWER: 48, defect_c\n","output_type":"stream"}],"execution_count":9},{"cell_type":"markdown","source":"---\n## Question 6 – Test-Time Augmentation and Tensor Flipping\n\nTensor shape: **(B, C, H, W)**. A 2×2 patch with 3 TTA views.","metadata":{}},{"cell_type":"code","source":"# (B, C, H, W) → horizontal flip = flip along W = dim -1 (or 3)\n#                 vertical flip   = flip along H = dim -2 (or 2)\n\norig      = np.array([[0.9, 0.6], [0.4, 0.2]])\nhflip_raw = np.array([[0.5, 0.8], [0.3, 0.4]])  # in flipped frame\nvflip_raw = np.array([[0.1, 0.5], [0.7, 0.9]])  # in flipped frame\n\n# Inverse the flips to align back to original frame\nhflip_inv = np.flip(hflip_raw, axis=1)  # flip columns back\nvflip_inv = np.flip(vflip_raw, axis=0)  # flip rows back\n\nprint(f\"Original:\\n{orig}\")\nprint(f\"Hflip in